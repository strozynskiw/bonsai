# Bonsai environment configuration
#
# Copy this file to .env and uncomment only the settings you need. Bonsai loads
# .env by default; set BONSAI_DOTENV=off in the process environment to disable
# loading. Values shown below are defaults or examples, never secrets.

# Provider connections

# Optional OpenCode API key bootstrap. You can also use /authorize opencode.
OPENCODE_API_KEY=your-opencode-api-key-here
# OPENCODE_MODEL=qwen3.7-max
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Optional OpenCode Zen connector. Uses OPENCODE_API_KEY.
# BONSAI_PROVIDER=opencode-zen
# OPENCODE_ZEN_MODEL=grok-code
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1

# Optional first-class OpenAI API connection.
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-5.6
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional generic OpenAI-compatible endpoint.
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_MODEL=llama-local
# OPENAI_COMPATIBLE_API_KEY=

# Optional generic Anthropic-compatible endpoint.
# ANTHROPIC_COMPATIBLE_BASE_URL=http://localhost:3000
# ANTHROPIC_COMPATIBLE_MODEL=claude-compatible-local
# ANTHROPIC_COMPATIBLE_API_KEY=

# Optional MiniMax pay-as-you-go API connector.
# MINIMAX_API_KEY=your-minimax-api-key-here
# MINIMAX_MODEL=MiniMax-M3
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# Optional MiniMax Coding/Token Plan connector. Subscription and pay-as-you-go
# keys are not interchangeable.
# MINIMAX_CODING_PLAN_API_KEY=your-minimax-coding-plan-key-here
# MINIMAX_CODING_PLAN_MODEL=MiniMax-M3
# MINIMAX_CODING_PLAN_BASE_URL=https://api.minimax.io/anthropic

# Optional Z.AI pay-as-you-go and Coding Plan connectors.
# ZAI_API_KEY=your-zai-api-key-here
# ZAI_MODEL=glm-5.2
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_CODING_PLAN_API_KEY=your-zai-coding-plan-key-here
# ZAI_CODING_PLAN_MODEL=glm-5.2
# ZAI_CODING_PLAN_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Optional Moonshot AI and Kimi Coding Plan connectors.
# MOONSHOT_API_KEY=your-moonshot-api-key-here
# MOONSHOT_MODEL=kimi-k2.7-code
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# KIMI_CODING_PLAN_API_KEY=your-kimi-coding-plan-key-here
# KIMI_CODING_PLAN_MODEL=kimi-for-coding
# KIMI_CODING_PLAN_BASE_URL=https://api.kimi.com/coding/v1

# Optional OpenRouter connector.
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# OPENROUTER_MODEL=openai/gpt-5.2
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional web-search credentials.
# BRAVE_SEARCH_API_KEY=your-brave-search-key-here
# TAVILY_API_KEY=your-tavily-key-here

# Core paths and session defaults

# State/config/cache root. Default: $HOME/.bonsai
# BONSAI_HOME=/path/to/.bonsai

# Explicit layered configuration file. Default: normal global/project discovery
# BONSAI_CONFIG=/path/to/config.toml

# Load .env. False-like values (0, false, off, no) disable loading.
# Default: on
# BONSAI_DOTENV=on

# Provider ID for fresh headless and eval sessions. Default: saved/default provider
# BONSAI_PROVIDER=anthropic

# Headless approval level: ask, conservative, balanced, auto-accept, or yolo.
# Default: CLI/configured autonomy
# BONSAI_AUTONOMY=balanced

# Self-review mode: auto, on, ask, or off. Default: configured mode
# BONSAI_SELF_REVIEW=auto

# Terminal color mode override. Values: truecolor/24bit, 256/xterm256, or none.
# Default: detect from NO_COLOR, COLORTERM, and TERM
# BONSAI_COLOR_MODE=truecolor

# Task-scoped context episodes. False-like values disable them. Default: on
# BONSAI_EPISODES=1

# Semantic memory embeddings. Set off, 0, or false for BM25-only search.
# Default: on
# BONSAI_MEMORY_EMBEDDINGS=on

# Logging and generation limits

# Tracing filter. Presence also raises Bonsai's default logging level to info.
# Default: warn unless BONSAI_LOG or RUST_LOG is set
# BONSAI_LOG=bonsai=debug

# Debug transcript destination. May contain sensitive conversation data.
# Default: disabled
# BONSAI_TRANSCRIPT_LOG=/tmp/bonsai-transcript.jsonl

# Generation inactivity deadline in seconds. Zero or invalid means no deadline.
# Default: no deadline
# BONSAI_MAX_GENERATION_SECONDS=300

# Maximum streamed response characters. A positive integer overrides the dynamic
# context-based limit. Default: 2x the context token budget, within built-in bounds
# BONSAI_MAX_STREAMED_CHARS=200000

# Sandbox

# Enable the sandbox: 1/on/true/yes/enabled or 0/off/false/no/disabled.
# Default: on when a sandbox backend is available
# BONSAI_SANDBOX=on

# Sandbox network policy: deny/denied/block/off or allow/allowed/on.
# Default: configured policy, otherwise deny
# BONSAI_SANDBOX_NETWORK=deny

# Additional sandbox-writable directories, separated by ':' on Unix.
# Default: none
# BONSAI_SANDBOX_WRITABLE_ROOTS=/path/one:/path/two

# File discovery

# Shared .gitignore policy for repo-map, glob, grep, read, and symbol search.
# Set false or 0 to include gitignored paths. Default: true
# BONSAI_RESPECT_GITIGNORE=true

# Optional per-tool overrides. Each takes precedence over the shared setting.
# BONSAI_REPO_MAP_RESPECT_GITIGNORE=true
# BONSAI_GLOB_RESPECT_GITIGNORE=true
# BONSAI_GREP_RESPECT_GITIGNORE=true
# BONSAI_READ_RESPECT_GITIGNORE=true
# BONSAI_SYMBOL_RESPECT_GITIGNORE=true

# Model catalog

# models.dev catalog endpoint. Default: https://models.dev/api.json
# BONSAI_MODELS_DEV_URL=https://models.dev/api.json

# Read models.dev JSON from a local file instead of normal cache/network behavior.
# Default: unset
# BONSAI_MODELS_DEV_PATH=/path/to/api.json

# Disable remote model-catalog refresh. True values: 1, true, yes.
# Default: false
# BONSAI_DISABLE_MODELS_FETCH=false

# models.dev cache lifetime in seconds. Zero forces a refresh. Default: 3600
# BONSAI_MODELS_DEV_TTL_SECS=3600

# Web search

# Preferred configured backend ID, such as brave, tavily, or searxng.
# Default: first available backend
# BONSAI_WEB_SEARCH_PROVIDER=brave

# SearXNG base URL; the instance must support JSON responses. Default: unset
# BONSAI_SEARXNG_URL=https://search.example.com

# Language-server executable overrides

# Defaults: commands found on PATH
# BONSAI_RUST_ANALYZER=/path/to/rust-analyzer
# BONSAI_TYPESCRIPT_LANGUAGE_SERVER=/path/to/typescript-language-server
# BONSAI_PYRIGHT_LANGSERVER=/path/to/pyright-langserver
# BONSAI_GOPLS=/path/to/gopls

# Codex compatibility

# Persist Codex reasoning items between requests (experimental). Default: false
# BONSAI_CODEX_REASONING_PERSIST=false

# Codex client version sent to the service. Default: detected CLI version or the
# built-in minimum compatible version
# BONSAI_CODEX_CLIENT_VERSION=0.1.0

# Build-time release verification
# These variables are consumed while compiling Bonsai, not from runtime .env.
# Both must be non-empty to embed release verification metadata.
# BONSAI_RELEASE_PUBLIC_KEY=<base64-public-key>
# BONSAI_RELEASE_TAG=v0.2.7

# Hook command environment (provided by Bonsai; do not set manually)
# BONSAI_HOOK_EVENT=<hook-event>
# BONSAI_PROJECT_ROOT=/path/to/project
# BONSAI_SESSION_ID=<runtime-session-id>
# BONSAI_TOOL_NAME=<tool-name>
# BONSAI_FILE_PATH=<affected-file>
# BONSAI_COMMAND=<shell-command>

# Installer controls (used by install.sh, not by the Bonsai binary)
# BONSAI_VERSION=v0.2.7
# BONSAI_INSTALL_DIR=$HOME/.local/bin
# BONSAI_NO_MODIFY_PATH=1
# BONSAI_SKIP_SIGNATURE=1

# Maintainer tooling (not used by the Bonsai binary)
# BONSAI_RELEASE_REMOTE=origin
# BONSAI_MODELS_DEV_CACHE=$HOME/.bonsai/cache/models-dev.json
# BONSAI_LITELLM_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
# BONSAI_STRICT_CROSSCHECK=1

# Test and internal variables (provided by Bonsai/tooling; do not set manually)
# BONSAI_DOCTOR_PROBE=/path/to/sandbox-probe
# BONSAI_LOCAL=<generated-local-provider-key>
# BONSAI_<PROVIDER>=<generated-provider-key>
# BONSAI_BIN=/path/to/bonsai
