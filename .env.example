# Optional OpenCode API key bootstrap.
# You can also authorize interactively with /authorize opencode.
# Get your key from https://opencode.ai/zen
OPENCODE_API_KEY=your-opencode-api-key-here

# Model to use (optional, defaults to qwen3.7-max)
# Run /model in the TUI to see available models
# OPENCODE_MODEL=qwen3.7-max

# API Base URL (optional, defaults to OpenCode Go)
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Optional OpenCode Zen connector with the broader Zen model catalog.
# Uses OPENCODE_API_KEY.
# BONSAI_PROVIDER=opencode-zen
# OPENCODE_ZEN_MODEL=grok-code
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1

# Optional first-class OpenAI API connection.
# Use with BONSAI_PROVIDER=openai, or authorize interactively with
# /authorize openai. The default model is gpt-5.6.
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-5.6
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional generic OpenAI-compatible endpoint for local/external servers.
# Use with BONSAI_PROVIDER=openai-compatible.
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_MODEL=llama-local
# OPENAI_COMPATIBLE_API_KEY=

# Optional generic Anthropic-compatible endpoint for local/external servers.
# Use with BONSAI_PROVIDER=anthropic-compatible.
# ANTHROPIC_COMPATIBLE_BASE_URL=http://localhost:3000
# ANTHROPIC_COMPATIBLE_MODEL=claude-compatible-local
# ANTHROPIC_COMPATIBLE_API_KEY=

# Optional MiniMax pay-as-you-go API connector.
# Use with BONSAI_PROVIDER=minimax.
# MINIMAX_API_KEY=your-minimax-api-key-here
# MINIMAX_MODEL=MiniMax-M3
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# Optional MiniMax Coding/Token Plan connector. Subscription keys are not
# interchangeable with pay-as-you-go API keys.
# Use with BONSAI_PROVIDER=minimax-coding-plan.
# MINIMAX_CODING_PLAN_API_KEY=your-minimax-coding-plan-key-here
# MINIMAX_CODING_PLAN_MODEL=MiniMax-M3
# MINIMAX_CODING_PLAN_BASE_URL=https://api.minimax.io/anthropic

# Optional Z.AI pay-as-you-go API connector.
# Use with BONSAI_PROVIDER=zai.
# ZAI_API_KEY=your-zai-api-key-here
# ZAI_MODEL=glm-5.2
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Optional Z.AI Coding Plan connector with separate credentials.
# Use with BONSAI_PROVIDER=zai-coding-plan.
# ZAI_CODING_PLAN_API_KEY=your-zai-coding-plan-key-here
# ZAI_CODING_PLAN_MODEL=glm-5.2
# ZAI_CODING_PLAN_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Optional Moonshot AI pay-as-you-go API connector.
# Use with BONSAI_PROVIDER=moonshotai.
# MOONSHOT_API_KEY=your-moonshot-api-key-here
# MOONSHOT_MODEL=kimi-k2.7-code
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Optional Kimi Coding Plan connector with its own subscription key.
# Use with BONSAI_PROVIDER=kimi-coding-plan.
# KIMI_CODING_PLAN_API_KEY=your-kimi-coding-plan-key-here
# KIMI_CODING_PLAN_MODEL=kimi-for-coding
# KIMI_CODING_PLAN_BASE_URL=https://api.kimi.com/coding/v1

# Optional OpenRouter connector.
# Use with BONSAI_PROVIDER=openrouter.
# Get your key from https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# OPENROUTER_MODEL=openai/gpt-5.2
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Models.dev catalog controls.
# BONSAI_MODELS_DEV_URL=https://models.dev/api.json
# BONSAI_MODELS_DEV_PATH=/path/to/models-dev.json
# BONSAI_DISABLE_MODELS_FETCH=1

# Optional provider-generation safety ceilings. Equivalent headless CLI flags
# override these values for one run.
# BONSAI_MAX_GENERATION_SECONDS=300
# BONSAI_MAX_STREAMED_CHARS=240000

# Task episodes are enabled by default. Explicit emergency opt-out:
# BONSAI_EPISODES=0

# Optional built-in web search. Bonsai auto-selects the first configured
# provider in this order: Brave, Tavily, SearXNG. Override with
# BONSAI_WEB_SEARCH_PROVIDER=brave|tavily|searxng.
# BRAVE_SEARCH_API_KEY=your-brave-search-key-here
# TAVILY_API_KEY=your-tavily-key-here
# BONSAI_SEARXNG_URL=https://search.example.com
