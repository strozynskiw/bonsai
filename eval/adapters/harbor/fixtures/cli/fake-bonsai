#!/bin/bash
set -euo pipefail
if [ "$1" = --version ]; then
  test -z "${DEEPSEEK_API_KEY:-}"
  echo synthetic-bonsai
  exit
fi
test "${DEEPSEEK_API_KEY:-}" = synthetic-not-a-credential
cat >/workspace/answer
case "$(cat /workspace/answer)" in
  fail) exit 7;;
  hang) sleep 600 & wait;;
esac
printf '%s\n' '{"provider":"deepseek","model":"fixture-model","status":"completed"}'
